# اجباری — توکن ربات تلگرام (از @BotFather)
# این تنها موردیه که موقع نصب (دکمه‌ی Deploy to Cloudflare) پرسیده می‌شه.
BOT_TOKEN=

# ⚠️ مقادیر زیر اختیاری‌ان و عمداً کامنت (#) شدن.
# دکمه‌ی Deploy فقط خط‌های «بدون #» رو موقع نصب می‌پرسه؛ پس این‌ها رو کامنت نگه دار.
# بعد از نصب، هر کدوم رو خواستی از پنل کلادفلر اضافه کن (توضیحش تو README هست).

# کلید Tavily برای جستجوی زنده در وب (tavily.com)
# TAVILY_API_KEY=

# برای نمایش وضعیت مصرف روزانه‌ی Neuron در /start و /model
# CF_API_TOKEN=
# CF_ACCOUNT_ID=

# آی‌دی عددی کاربران مجاز تلگرام، جدا شده با کاما؛ خالی یعنی ربات برای همه باز است
# ALLOWED_USER_IDS=
