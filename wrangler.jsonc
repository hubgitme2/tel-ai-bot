{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tel-ai-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [],

  "observability": {
    "enabled": true
  },

  // حافظه‌ی مکالمه + مدل انتخابی هر کاربر (KV).
  // id خالیه چون قراره خودِ دکمه‌ی «Deploy to Cloudflare» این namespace رو خودکار بسازه و بایند کنه.
  "kv_namespaces": [
    {
      "binding": "CHAT_HISTORY",
      "id": ""
    }
  ],

  // دسترسی به Workers AI. با همین بایند، دکمه‌ی دیپلوی به‌صورت خودکار دسترسی AI رو
  // روی اکانت کاربر فعال می‌کنه؛ نیازی به کار دستی در پنل نیست.
  "ai": {
    "binding": "AI"
  },

  // BOT_TOKEN تنها متغیری‌ست که موقع نصب پرسیده می‌شه و پر کردنش اجباریه؛ اگر خالی بمونه،
  // خودِ wrangler دیپلوی رو با خطای «BOT_TOKEN تنظیم نشده» متوقف می‌کنه.
  // TAVILY_API_KEY / CF_API_TOKEN / CF_ACCOUNT_ID / ALLOWED_USER_IDS اختیاری‌ان و عمداً
  // در .dev.vars.example کامنت شدن تا موقع نصب پرسیده نشن؛ بعد از نصب از پنل کلادفلر اضافه می‌شن
  // (کد داخل src/index.js هم برای هر کدوم حالت «تنظیم نشده» رو هندل می‌کنه).
  "secrets": {
    "required": ["BOT_TOKEN"]
  }
}
